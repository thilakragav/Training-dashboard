# ==============================================================================
# NEXORA TECH ACADEMY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit real production secrets into version control.
# ==============================================================================

# Backend Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma ORM)
# Supported: Supabase, Neon, AWS RDS, Railway, Render, Docker PostgreSQL, or local
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/nexora_academy_db?schema=public"

# JSON Web Token Secret (Generate a 64+ char random hex string in production)
JWT_SECRET="example_super_secure_jwt_secret_for_nexora_academy_development_only_2026"

# Allowed CORS Origins (comma-separated for multiple domains or custom GoDaddy subdomains)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,https://nexoratech.com"

# Frontend API Base URL (Used by Vite frontend client)
VITE_API_URL="http://localhost:5000/api"
